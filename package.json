{
  "name": "popi-player",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Reproductor de música con estilo empaque Terrabusi — React + Express + SQLite",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:server\" \"npm:client\"",
    "server": "node --watch server/index.js",
    "client": "vite",
    "scan": "node server/scan.js",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "express": "^5.3.0",
    "music-metadata": "^12.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
